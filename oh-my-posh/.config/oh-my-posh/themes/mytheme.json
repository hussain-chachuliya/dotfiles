{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#1e1e2e",
          "foreground": "#cdd6f4",
          "leading_diamond": "\u256d\u2500\ue0b6",
          "style": "diamond",
          "template": "{{ if .SSHSession }}\ueba9 {{ end }}{{ .UserName }}@{{ .HostName }} ",
          "type": "session"
        },
        {
          "background": "#313244",
          "foreground": "#89b4fa",
          "powerline_symbol": "\ue0b0",
          "properties": {
            "style": "full"
          },

          "style": "powerline",
          "template": " \uf07b </>{{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#313244",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#45475a{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#45475a{{ end }}",
            "{{ if gt .Ahead 0 }}#45475a{{ end }}",
            "{{ if gt .Behind 0 }}#45475a{{ end }}"
          ],
          "foreground": "#a6e3a1",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#fab387{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#f9e2af{{ end }}",
            "{{ if gt .Ahead 0 }}#cba6f7{{ end }}",
            "{{ if gt .Behind 0 }}#cba6f7{{ end }}"
          ],
          "powerline_symbol": "\ue0b0",
          "properties": {
            "fetch_stash_count": true,
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "powerline",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "type": "git"
        },
        {
          "background": "#45475a",
          "background_templates": ["{{ if gt .Code 0 }}#f38ba8{{ end }}"],
          "foreground": "#f9e2af",
          "foreground_templates": ["{{ if gt .Code 0 }}#1e1e2e{{ end }}"],
          "properties": {
            "always_enabled": true
          },
          "style": "diamond",
          "template": " {{ if gt .Code 0 }}\uf00d {{ reason .Code }}{{ else }}\uf42e {{ end }}",
          "trailing_diamond": "\ue0b0",
          "type": "status"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "background": "#45475a",
          "foreground": "#cba6f7",
          "type": "executiontime",
          "style": "powerline",
          "options": {
            "always_enabled": true
          },
          "powerline_symbol": "\ue0b2",
          "template": " \uf252 {{ .FormattedMs }} ",
          "invert_powerline": true
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#cdd6f4",
          "style": "plain",
          "template": "\u2570\u2500",
          "type": "text"
        },
        {
          "foreground": "#89dceb",
          "foreground_templates": ["{{ if gt .Code 0 }}#f38ba8{{ end }}"],
          "properties": {
            "always_enabled": true
          },
          "style": "plain",
          "template": "<#cba6f7>\u276f</><#a6e3a1>\u276f</><#f9e2af>\u276f</> ",
          "type": "status"
        }
      ],
      "type": "prompt"
    }
  ],
  "version": 2
}

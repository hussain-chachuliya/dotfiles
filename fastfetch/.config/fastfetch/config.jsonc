{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty",
        "source": "~/.config/fastfetch/logo.png",
        "width": 35,
        "height": 20,
        "padding": {
            "right": 2
        }
    },
    "display": {
        "separator": ": ",
        "color": {
            "keys": "blue",
            "title": "red"
        },
        "key": {
            "width": 18,
            "type": "string"
        },
        "size": {
            "maxPrefix": "GB",
            "ndigits": 2
        },
        "freq": {
            "ndigits": 2,
            "spaceBeforeUnit": "never"
        },
        "percent": {
            "type": 9
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        {
            "type": "packages",
            "combined": true
        },
        "shell",
        {
            "type": "display",
            "compactType": "original",
            "key": "Resolution"
        },
        {
            "type": "de",
            "key": "DE"
        },
        {
            "type": "wm",
            "key": "WM"
        },
        "wmtheme",
        "theme",
        "icons",
        "font",
        "cursor",
        "terminal",
        {
            "type": "terminalfont",
            "format": "{/name}{-}{/}{name}{?size} {size}{?}"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "showPeCoreCount": true,
            "temp": true,
            "format": "{name} ({cores-physical}C/{cores-logical}T) @ {freq-max}{?temperature} ({temperature}){?}"
        },
        {
            "type": "gpu",
            "key": "GPU",
            "temp": true,
            "format": "{name}{?temperature} ({temperature}){?}"
        },
//         {
//             "type": "memory",
//             "key": "Memory",
//             "format": "{used} / {total} ({percentage})"
//         },
//         {
//             "type": "swap",
//             "key": "Swap",
//             "format": "{used} / {total}"
//         },
//         {
//             "type": "disk",
//             "key": "Disk: {mountpoint}",
//             "format": "{size-used} / {size-total} ({size-percentage})"
//         },
//         {
//             "type": "battery",
//             "key": "Battery",
//             "temp": true
//         },
        "poweradapter",
        {
            "type": "localip",
            "key": "Local IP",
            "showIpv4": true,
            "showIpv6": false,
            "showMac": false
        },
        "break",
    ]
}

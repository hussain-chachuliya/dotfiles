{
  "plugins": {
    "orchestrator": {
      "settings": {
        "autoOpenDock": "never"
      }
    }
  },
  "theme": "builtin://dark",
  "editor": {
    "line_wrap": true,
    "show_menu_bar": false,
    "show_prompt_line": true,
    "show_status_bar": true
  },
  "lsp": {
    "kotlin": [
      {
        "command": "kotlin-lsp",
        "enabled": true,
        "args": ["--stdio"],
        "auto_start": false,
        "root_markers": ["settings.gradle.kts", "settings.gradle", "pom.xml", "workspace.json"],
        "process_limits": {
          "max_memory_percent": 50,
          "max_cpu_percent": 90,
          "enabled": true
        }
      }
    ]
  },
  "file_browser": {
    "show_hidden": true
  },
  "file_explorer": {
    "show_hidden": true
  }
}
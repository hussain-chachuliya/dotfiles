// Key bindings.
// https://yalter.github.io/niri/Configuration:-Key-Bindings
// -----------------------------------------------------------------------------
binds {
    // =========================================================================
    // WINDOW MANAGEMENT
    // =========================================================================
    Mod+Q repeat=false hotkey-overlay-title="Close Window" {
        close-window
    }
    Mod+Shift+Q repeat=false hotkey-overlay-title="Force-Kill Window Process" {
        spawn-sh "~/.config/niri/scripts/kill-focused.sh"
    }
    // Escape hatch so a remote-desktop client or software KVM can never hold
    // the session hostage.
    Mod+Ctrl+Shift+Escape repeat=false hotkey-overlay-title="Toggle Keyboard Shortcuts Inhibitor" {
        toggle-keyboard-shortcuts-inhibit
    }
    Mod+Alt+Space repeat=false hotkey-overlay-title="Toggle Floating" {
        toggle-window-floating
    }
    Mod+Shift+Space repeat=false {
        switch-focus-between-floating-and-tiling
    }
    Mod+F repeat=false hotkey-overlay-title="Fullscreen" {
        fullscreen-window
    }
    Mod+M repeat=false hotkey-overlay-title="Maximize Column" {
        maximize-column
    }
    Mod+Ctrl+F repeat=false {
        expand-column-to-available-width
    }
    Mod+Ctrl+M repeat=false {
        maximize-window-to-edges
    }
    Mod+G repeat=false hotkey-overlay-title="Toggle Tabbed Column" {
        toggle-column-tabbed-display
    }
    Mod+BracketLeft {
        consume-or-expel-window-left
    }
    Mod+BracketRight {
        consume-or-expel-window-right
    }
    Mod+Comma {
        consume-window-into-column
    }
    Mod+Period {
        expel-window-from-column
    }
    Mod+Minus repeat=true hotkey-overlay-title="Narrow Column" {
        set-column-width "-10%"
    }
    Mod+Equal repeat=true hotkey-overlay-title="Widen Column" {
        set-column-width "+10%"
    }
    Mod+Shift+Minus repeat=true {
        set-window-height "-10%"
    }
    Mod+Shift+Equal repeat=true {
        set-window-height "+10%"
    }
    // --- Focus ---
    Mod+Left {
        focus-column-left
    }
    Mod+Down {
        focus-window-down
    }
    Mod+Up {
        focus-window-up
    }
    Mod+Right {
        focus-column-right
    }
    Mod+Home {
        focus-column-first
    }
    Mod+End {
        focus-column-last
    }
    Mod+Ctrl+Home {
        move-column-to-first
    }
    Mod+Ctrl+End {
        move-column-to-last
    }
    Mod+Shift+Tab repeat=false {
        focus-workspace-previous
    }
    // --- Move focus ---
    Mod+Ctrl+Left {
        move-column-left
    }
    Mod+Ctrl+Down {
        move-window-down
    }
    Mod+Ctrl+Up {
        move-window-up
    }
    Mod+Ctrl+Right {
        move-column-right
    }
    // --- Swap ---
    Mod+Alt+Left {
        swap-window-left
    }
    Mod+Alt+Right {
        swap-window-right
    }
    // =========================================================================
    // MONITORS
    // =========================================================================
    // Output names come from `niri msg outputs`. They are hardcoded because niri
    // has no config variables; edit both output.kdl and this block together.
    // Only eDP-2 is connected, so only it gets a named bind. If a second panel
    // shows up, give it Mod+Alt+1 / Mod+Alt+Shift+1 and add an output block.
    Mod+Alt+2 repeat=false hotkey-overlay-title="Focus eDP-2" {
        focus-monitor "eDP-2"
    }
    Mod+Shift+Left {
        focus-monitor-left
    }
    Mod+Shift+Down {
        focus-monitor-down
    }
    Mod+Shift+Up {
        focus-monitor-up
    }
    Mod+Shift+Right {
        focus-monitor-right
    }
    // move window to a monitor, by name.
    Mod+Alt+Shift+2 repeat=false hotkey-overlay-title="Move Column to eDP-2" {
        move-column-to-monitor "eDP-2"
    }
    Mod+Shift+Ctrl+Left {
        move-column-to-monitor-left
    }
    Mod+Shift+Ctrl+Down {
        move-column-to-monitor-down
    }
    Mod+Shift+Ctrl+Up {
        move-column-to-monitor-up
    }
    Mod+Shift+Ctrl+Right {
        move-column-to-monitor-right
    }
    Mod+Alt+Shift+H {
        move-column-to-monitor-previous
    }
    Mod+Alt+Shift+L {
        move-column-to-monitor-next
    }
    // =========================================================================
    // WORKSPACES
    // =========================================================================
    // niri's workspaces are dynamic and created on demand, so there is no
    // `persistent = true` equivalent and none is needed.
    Mod+1 repeat=false {
        focus-workspace 1
    }
    Mod+2 repeat=false {
        focus-workspace 2
    }
    Mod+3 repeat=false {
        focus-workspace 3
    }
    Mod+4 repeat=false {
        focus-workspace 4
    }
    Mod+5 repeat=false {
        focus-workspace 5
    }
    Mod+6 repeat=false {
        focus-workspace 6
    }
    Mod+7 repeat=false {
        focus-workspace 7
    }
    Mod+8 repeat=false {
        focus-workspace 8
    }
    Mod+9 repeat=false {
        focus-workspace 9
    }
    Mod+Ctrl+1 repeat=false {
        move-column-to-workspace 1
    }
    Mod+Ctrl+2 repeat=false {
        move-column-to-workspace 2
    }
    Mod+Ctrl+3 repeat=false {
        move-column-to-workspace 3
    }
    Mod+Ctrl+4 repeat=false {
        move-column-to-workspace 4
    }
    Mod+Ctrl+5 repeat=false {
        move-column-to-workspace 5
    }
    Mod+Ctrl+6 repeat=false {
        move-column-to-workspace 6
    }
    Mod+Ctrl+7 repeat=false {
        move-column-to-workspace 7
    }
    Mod+Ctrl+8 repeat=false {
        move-column-to-workspace 8
    }
    Mod+Ctrl+9 repeat=false {
        move-column-to-workspace 9
    }
    Mod+Page_Down repeat=false hotkey-overlay-title="Next Workspace" {
        focus-workspace-down
    }
    Mod+Page_Up repeat=false {
        focus-workspace-up
    }
    Mod+I repeat=false {
        focus-workspace-up
    }
    // Relative workspace moves.
    Mod+Ctrl+Page_Down {
        move-column-to-workspace-down
    }
    Mod+Ctrl+Page_Up {
        move-column-to-workspace-up
    }
    Mod+Shift+Page_Down {
        move-workspace-down
    }
    Mod+Shift+Page_Up {
        move-workspace-up
    }
    Mod+Shift+I {
        move-workspace-up
    }
    // Scroll through workspaces, with a cooldown so it does not fly past.
    Mod+WheelScrollDown cooldown-ms=150 {
        focus-workspace-down
    }
    Mod+WheelScrollUp cooldown-ms=150 {
        focus-workspace-up
    }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 {
        move-column-to-workspace-down
    }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 {
        move-column-to-workspace-up
    }
    // Horizontal scroll moves columns rather than workspaces, with the vertical
    // pair (Mod / Mod+Shift / Mod+Ctrl / Mod+Ctrl+Shift) as the modifier tier.
    Mod+WheelScrollRight {
        focus-column-right
    }
    Mod+WheelScrollLeft {
        focus-column-left
    }
    Mod+Ctrl+WheelScrollRight {
        move-column-right
    }
    Mod+Ctrl+WheelScrollLeft {
        move-column-left
    }
    Mod+Shift+WheelScrollRight {
        focus-column-right
    }
    Mod+Shift+WheelScrollLeft {
        focus-column-left
    }
    Mod+Ctrl+Shift+WheelScrollRight {
        move-column-right
    }
    Mod+Ctrl+Shift+WheelScrollLeft {
        move-column-left
    }
    // =========================================================================
    // OVERVIEW
    // =========================================================================
    Alt+Tab repeat=false hotkey-overlay-title="Toggle Overview" {
        toggle-overview
    }
    // niri's "Important Hotkeys" overlay. debug.kdl sets skip-at-startup so
    // it does not pop up on every fresh start; this is the manual way in.
    Mod+Shift+Escape repeat=false hotkey-overlay-title="Show Hotkey Overlay" {
        show-hotkey-overlay
    }
    // =========================================================================
    // LAUNCHER
    // =========================================================================
    Mod+Return repeat=false hotkey-overlay-title="Open a Terminal" {
        spawn "kitty"
    }
    Mod+E repeat=false hotkey-overlay-title="Open Yazi File Manager" {
        spawn "kitty" "yazi"
    }
    Mod+B repeat=false hotkey-overlay-title="Open Browser" {
        spawn "helium-browser"
    }
    Mod+N repeat=false hotkey-overlay-title="Open Notes" {
        spawn "obsidian"
    }
    Mod+T repeat=false hotkey-overlay-title="Open nvim text editor" {
        spawn "kitty" "nvim"
    }
    XF86Calculator repeat=false hotkey-overlay-title="Open Calculator" {
        spawn "gnome-calculator"
    }
    Ctrl+Alt+Delete repeat=false hotkey-overlay-title="Open Btop" {
        spawn "kitty" "btop"
    }
    // =========================================================================
    // PANELS
    // =========================================================================
    Mod+L repeat=false hotkey-overlay-title="Open LocalSend" {
        spawn "localsend"
    }
    // =========================================================================
    // SYSTEM
    // =========================================================================
    Mod+Shift+E repeat=false hotkey-overlay-title="Quit niri" {
        quit
    }
    Mod+Shift+F11 repeat=false {
        power-on-monitors
    }
    Mod+Shift+F12 repeat=false {
        power-off-monitors
    }
    // =========================================================================
    // THEMING & WALLPAPER
    // =========================================================================
    // hyprpicker is Hyprland-only. niri has a built-in picker; the wrapper also
    // copies the hex to the clipboard, which is what `hyprpicker -a` did.
    Mod+P repeat=false hotkey-overlay-title="Pick Color" {
        spawn-sh "~/.config/niri/scripts/pick-color.sh"
    }
    // urdu-translit: transliterate the selection to Urdu, in place.
    // Absolute path on purpose: niri's spawn does not read a login shell's
    // PATH, and this tool lives in ~/.local/bin.
    //
    // The tool grabs the primary selection, transliterates, and types the
    // result back. It settles internally (COPY_SETTLE/PASTE_SETTLE) to let go
    // of Mod+Shift before sending its own synthetic Ctrl+C / Ctrl+V, so
    // release-key wiring is not needed here the way it was in Hyprland.
    //
    // REQUIRES wtype. Without it, --clip fails with "wtype is not installed".
    // Verify with: urdu-translit --selftest
    // Whole line: type "aap kaise hen" -> Mod+U -> "آپ کیسے ہیں"
    Mod+U repeat=false hotkey-overlay-title="Urdu: Convert Line" {
        spawn-sh "~/.local/bin/urdu-translit --clip"
    }
    // Single word under cursor: after Mod+U, if "hen" -> "ہن" is wrong,
    // move cursor into that word and press Mod+Shift+U to cycle only that
    // word ("ہن" -> "ہیں"). Replaces Ctrl+Shift+Right word-select + copy.
    // Falls back to existing selection if the app ignores word keys.
    Mod+Shift+U repeat=false hotkey-overlay-title="Urdu: Fix Word" {
        spawn-sh "~/.local/bin/urdu-translit --clip --word --pick 2"
    }
}
